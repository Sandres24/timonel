{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error",
  },
  "overrides": [
    {
      "files": [
        "src/**/application/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@nestjs/*",
                  "typeorm",
                  "typeorm/*",
                  "ioredis",
                  "bullmq",
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "Application no puede depender de frameworks ni adaptadores externos."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/**/domain/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@nestjs/*"
                ],
                "message": "El dominio no puede depender de NestJS."
              },
              {
                "group": [
                  "typeorm",
                  "typeorm/*"
                ],
                "message": "El dominio no puede depender de TypeORM."
              },
              {
                "group": [
                  "ioredis"
                ],
                "message": "El dominio no puede depender de Redis."
              },
              {
                "group": [
                  "bullmq"
                ],
                "message": "El dominio no puede depender de bullmq."
              },
              {
                "group": [
                  "**/application/**",
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "El dominio no puede importar otras capas."
              }
            ],
          }
        ]
      }
    },
    {
      "files": [
        "src/core/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/modules/**"
                ],
                "message": "Core no puede importar desde modules, modules sí puede depender de core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "test/**",
        "**/*.test.ts",
        "**/*.spec.ts"
      ],
      "rules": {
        "typescript/unbound-method": "off",
      },
    }
  ],
  "env": {
    "node": true
  }
}